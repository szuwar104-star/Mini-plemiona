{
  // Mini Plemiona: statyczne pliki gry + worker do synchronizacji zapisu (/api/save/...)
  "name": "mini-plemiona",
  "main": "worker.mjs",
  "compatibility_date": "2025-11-01",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  // Bez "id": wrangler sam utworzy przestrzeń KV przy pierwszym wdrożeniu
  "kv_namespaces": [{ "binding": "SAVES" }]
}
